# Copiar a .env (no se sube a git) y rellenar.

# Servidor
PUERTO=4100
HOST=127.0.0.1
# Orígenes permitidos por CORS, separados por comas
ORIGEN_PERMITIDO=https://cortes.geospatiallab.xyz

# Base de datos (rol propio, NO el de BIDELAN)
PGHOST=localhost
PGPORT=5432
# La BD donde están public.ejes_tronco y el esquema cortes
PGDATABASE=
PGUSER=cortes_app
PGPASSWORD=

# JWT: secreto PROPIO, distinto del de BIDELAN (mín. 32 caracteres)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRACION=8h

# Admin inicial (node bootstrapAdmin.js)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
